# Shared cloud database: Supabase project "beauty-saas", region eu-central-1.
# Copy both lines from the project owner's .env. Do not commit the password.
# Runtime uses the transaction pooler (port 6543).
DATABASE_URL="postgresql://beauty_app.rfmyeiuewthknxmbarkc:[password]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Migrations and introspection use the session pooler (port 5432).
DIRECT_URL="postgresql://beauty_app.rfmyeiuewthknxmbarkc:[password]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?schema=public"

# Auth.js session encryption. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client from Google Cloud.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"
